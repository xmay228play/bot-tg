# Токен бота от @BotFather — обязательное поле
BOT_TOKEN=вставь_сюда_токен_от_BotFather

# Публичный URL сервера (где будет Mini App)
# Для Railway: https://твой-проект.up.railway.app
# Для localhost: http://localhost:8000
WEBAPP_URL=https://ваш-домен.ru

# Секретный ключ для подписи запросов
# Можно сгенерировать: openssl rand -hex 32
SECRET_KEY=придумай_длинную_случайную_строку

# Telegram ID админа(ов) через запятую
# Узнать свой ID: @userinfobot
ADMIN_IDS=0